rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Leaderboards: boards/{board}/scores/{id}
    match /boards/{board}/scores/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 30
        && (
          (request.resource.data.score is number
            && request.resource.data.score >= 0
            && request.resource.data.score < 20000)
          ||
          (request.resource.data.time is number
            && request.resource.data.time > 20
            && request.resource.data.time < 3600)
        );
      allow update, delete: if false;
    }

    // Visitor statistics (anonymous counters): stats/all and stats/d_YYYY-MM-DD
    function grows(f) {
      return !(f in request.resource.data)
        || (request.resource.data[f] is int
          && request.resource.data[f] <= (resource == null ? 0 : resource.data.get(f, 0)) + 1);
    }
    match /stats/{id} {
      allow read: if true;
      allow create, update: if (id == 'all' || id.matches('d_[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && request.resource.data.keys().hasOnly(['visits', 'newVisitors', 'returning', 'ownerVisits', 'countries', 'devices', 'langs', 'hours', 'weekdays', 'dives', 'levels', 'subs', 'modes', 'multiplayer'])
        && grows('visits') && grows('dives') && grows('newVisitors') && grows('returning') && grows('ownerVisits') && grows('multiplayer');
      allow delete: if false;
    }
    // last visits (no names, no IPs): country, device, language, new/returning, hour
    match /visits/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['t', 'cc', 'dev', 'lang', 'ret', 'h'])
        && request.resource.data.t == request.time
        && request.resource.data.cc is string && request.resource.data.cc.size() == 2
        && request.resource.data.dev in ['phone', 'tablet', 'desktop']
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 3
        && request.resource.data.ret is bool
        && request.resource.data.h is int && request.resource.data.h >= 0 && request.resource.data.h < 24;
      allow update, delete: if false;
    }
  }
}
