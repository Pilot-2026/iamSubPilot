{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && (data.child('meta/host').val() === auth.uid || !data.child('players').exists())",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "events": {
          "$event": {
            ".write": "auth != null && !data.exists()"
          }
        }
      }
    }
  }
}
